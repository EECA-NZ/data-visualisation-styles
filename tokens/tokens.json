{
  "name": "EECA data visualisation styles",
  "version": "0.1.0",
  "source": {
    "baseline": "eeud-dashboard",
    "reviewed": "2026-08-28"
  },
  "colors": {
    "neutral": {
      "white": "#FFFFFF",
      "black": "#000000",
      "silver": "#FBFBFB",
      "iron": "#E8ECEE",
      "muted": "#9CA2B0"
    },
    "brand": {
      "sunset-purple": "#5A1A5E",
      "sunset-purple-light": "#7B467E",
      "moss-green": "#05422D",
      "moss-green-light": "#376856",
      "sea-blue": "#0A3C61",
      "sea-blue-light": "#3C6280",
      "dusky-lilac": "#D2B7FE",
      "dusky-lilac-light": "#D7C2F5",
      "fresh-teal": "#2ADEA9",
      "fresh-teal-light": "#57E5BA",
      "sky-blue": "#74DCDB",
      "sky-blue-light": "#91E2E2",
      "sunrise-yellow": "#F8CE7D",
      "sunrise-yellow-light": "#FAD999",
      "pale-teal": "#C0EBEB"
    },
    "dark-mode": {
      "canvas": "#1A2B25",
      "surface": "#0F1F1A",
      "border": "#2A3D35",
      "text": "#E8F5F0",
      "grid": "#3C3E42",
      "axis": "#555E64"
    },
    "interface": {
      "page": "{colors.neutral.silver}",
      "surface": "{colors.neutral.white}",
      "border": "{colors.neutral.iron}",
      "text": "{colors.neutral.black}",
      "grid": "{colors.brand.pale-teal}",
      "axis": "{colors.neutral.muted}",
      "selection": "{colors.brand.sky-blue-light}"
    }
  },
  "palettes": {
    "categorical": [
      "{colors.brand.sea-blue}",
      "{colors.brand.fresh-teal}",
      "{colors.brand.sunset-purple}",
      "{colors.brand.sunrise-yellow}",
      "{colors.brand.sky-blue}",
      "{colors.brand.moss-green}",
      "{colors.brand.dusky-lilac}",
      "{colors.brand.sea-blue-light}",
      "{colors.brand.fresh-teal-light}",
      "{colors.brand.sunset-purple-light}",
      "{colors.brand.moss-green-light}"
    ],
    "sequential-blue": [
      "{colors.brand.pale-teal}",
      "{colors.brand.sky-blue-light}",
      "{colors.brand.sky-blue}",
      "{colors.brand.sea-blue-light}",
      "{colors.brand.sea-blue}"
    ],
    "sequential-green": [
      "#4DDEC9",
      "#36DFA8",
      "#2FBB8B",
      "#12593C",
      "#05422D"
    ],
    "sequential-purple": [
      "{colors.brand.dusky-lilac-light}",
      "{colors.brand.dusky-lilac}",
      "#C09EE7",
      "{colors.brand.sunset-purple-light}",
      "{colors.brand.sunset-purple}"
    ]
  },
  "typography": {
    "families": {
      "brand": "National 2",
      "portable": "Arial",
      "generic": "sans-serif"
    },
    "platforms": {
      "web": [
        "National 2",
        "Arial",
        "sans-serif"
      ],
      "charts": [
        "Arial",
        "sans-serif"
      ],
      "databricks": [
        "Inter"
      ]
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    },
    "sizes-px": {
      "body": 16,
      "chart": 14,
      "h1": 28,
      "h2": 24,
      "h3": 20,
      "h4": 18,
      "h5": 16
    },
    "databricks-roles": {
      "base": {
        "size-px": 14,
        "weight": 400
      },
      "fieldTitle": {
        "size-px": 14,
        "weight": 700
      },
      "fieldValue": {
        "size-px": 16,
        "weight": 500
      },
      "widgetDescription": {
        "size-px": 14,
        "weight": 400
      },
      "widgetTitle": {
        "size-px": 16,
        "weight": 700
      }
    }
  },
  "shape": {
    "corner-radius-px": 0
  },
  "platforms": {
    "databricks": {
      "theme": {
        "canvasBackgroundColor": {
          "light": "{colors.interface.page}",
          "dark": "{colors.dark-mode.canvas}"
        },
        "widgetBackgroundColor": {
          "light": "{colors.interface.surface}",
          "dark": "{colors.dark-mode.surface}"
        },
        "widgetBorderColor": {
          "light": "{colors.interface.border}",
          "dark": "{colors.dark-mode.border}"
        },
        "fontColor": {
          "light": "{colors.interface.text}",
          "dark": "{colors.dark-mode.text}"
        },
        "selectionColor": {
          "light": "{colors.interface.selection}",
          "dark": "{colors.brand.fresh-teal}"
        },
        "gridLineColor": {
          "light": "{colors.interface.grid}",
          "dark": "{colors.dark-mode.grid}"
        },
        "axisLineColor": {
          "light": "{colors.interface.axis}",
          "dark": "{colors.dark-mode.axis}"
        },
        "widgetCornerRadius": "{shape.corner-radius-px}",
        "widgetPadding": 14,
        "widgetMargin": 10,
        "widgetShadow": 0,
        "widgetHeaderAlignment": "LEFT",
        "continuousGradient": {
          "lightMode": {
            "fromCategoricalIndex": 0
          },
          "darkMode": {
            "fromCategoricalIndex": 1
          }
        }
      }
    }
  }
}
