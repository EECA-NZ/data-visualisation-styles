{
  "name": "EECA data visualisation styles",
  "version": "0.1.0",
  "source": {
    "baseline": "eeud-dashboard",
    "reviewed": "2026-08-28"
  },
  "colors": {
    "neutral": {
      "white": "#FFFFFF",
      "black": "#000000",
      "silver": "#FBFBFB",
      "iron": "#E8ECEE",
      "muted": "#9CA2B0"
    },
    "brand": {
      "sunset-purple": "#5A1A5E",
      "sunset-purple-light": "#7B467E",
      "moss-green": "#05422D",
      "moss-green-light": "#376856",
      "sea-blue": "#0A3C61",
      "sea-blue-light": "#3C6280",
      "dusky-lilac": "#D2B7FE",
      "dusky-lilac-light": "#D7C2F5",
      "fresh-teal": "#2ADEA9",
      "fresh-teal-light": "#57E5BA",
      "sky-blue": "#74DCDB",
      "sky-blue-light": "#91E2E2",
      "sunrise-yellow": "#F8CE7D",
      "sunrise-yellow-light": "#FAD999",
      "pale-teal": "#C0EBEB"
    },
    "dark-mode": {
      "canvas": "#1A2B25",
      "surface": "#0F1F1A",
      "border": "#2A3D35",
      "text": "#E8F5F0",
      "grid": "#3C3E42",
      "axis": "#555E64"
    },
    "interface": {
      "page": "#FBFBFB",
      "surface": "#FFFFFF",
      "border": "#E8ECEE",
      "text": "#000000",
      "grid": "#C0EBEB",
      "axis": "#9CA2B0",
      "selection": "#91E2E2"
    }
  },
  "palettes": {
    "categorical": [
      "#0A3C61",
      "#2ADEA9",
      "#5A1A5E",
      "#F8CE7D",
      "#74DCDB",
      "#05422D",
      "#D2B7FE",
      "#3C6280",
      "#57E5BA",
      "#7B467E",
      "#376856"
    ],
    "sequential-blue": [
      "#C0EBEB",
      "#91E2E2",
      "#74DCDB",
      "#3C6280",
      "#0A3C61"
    ],
    "sequential-green": [
      "#4DDEC9",
      "#36DFA8",
      "#2FBB8B",
      "#12593C",
      "#05422D"
    ],
    "sequential-purple": [
      "#D7C2F5",
      "#D2B7FE",
      "#C09EE7",
      "#7B467E",
      "#5A1A5E"
    ]
  },
  "typography": {
    "families": {
      "brand": "National 2",
      "portable": "Arial",
      "generic": "sans-serif"
    },
    "platforms": {
      "web": [
        "National 2",
        "Arial",
        "sans-serif"
      ],
      "charts": [
        "Arial",
        "sans-serif"
      ],
      "databricks": [
        "Inter"
      ]
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    },
    "sizes-px": {
      "body": 16,
      "chart": 14,
      "h1": 28,
      "h2": 24,
      "h3": 20,
      "h4": 18,
      "h5": 16
    },
    "databricks-roles": {
      "base": {
        "size-px": 14,
        "weight": 400
      },
      "fieldTitle": {
        "size-px": 14,
        "weight": 700
      },
      "fieldValue": {
        "size-px": 16,
        "weight": 500
      },
      "widgetDescription": {
        "size-px": 14,
        "weight": 400
      },
      "widgetTitle": {
        "size-px": 16,
        "weight": 700
      }
    }
  },
  "shape": {
    "corner-radius-px": 0
  },
  "platforms": {
    "databricks": {
      "theme": {
        "canvasBackgroundColor": {
          "light": "#FBFBFB",
          "dark": "#1A2B25"
        },
        "widgetBackgroundColor": {
          "light": "#FFFFFF",
          "dark": "#0F1F1A"
        },
        "widgetBorderColor": {
          "light": "#E8ECEE",
          "dark": "#2A3D35"
        },
        "fontColor": {
          "light": "#000000",
          "dark": "#E8F5F0"
        },
        "selectionColor": {
          "light": "#91E2E2",
          "dark": "#2ADEA9"
        },
        "gridLineColor": {
          "light": "#C0EBEB",
          "dark": "#3C3E42"
        },
        "axisLineColor": {
          "light": "#9CA2B0",
          "dark": "#555E64"
        },
        "widgetCornerRadius": 0,
        "widgetPadding": 14,
        "widgetMargin": 10,
        "widgetShadow": 0,
        "widgetHeaderAlignment": "LEFT",
        "continuousGradient": {
          "lightMode": {
            "fromCategoricalIndex": 0
          },
          "darkMode": {
            "fromCategoricalIndex": 1
          }
        }
      }
    }
  }
}
